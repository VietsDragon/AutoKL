                font-family: 'Segoe UI', Roboto, Arial, sans-serif;
                font-size: 13.5px;
                font-weight: 600;
                text-align: center;
                padding: 9px 16px;
                box-shadow: 0 2px 10px rgba(0,0,0,.3);
                display: none;
                align-items: center;
