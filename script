    async function skipCurrentCase(reason) {

        const name =
            getPatientName();

        log(
            `⏭️ Bỏ qua ca "${name}": ${reason}`
        );

        addToSkippedList({
            name,
            reason
        });

        incSkipIndex();

        showToast(
            `⏭️ Bỏ qua "${name}" (${reason}) - đang qua ca tiếp theo...`,
            3500
        );

        await sleep(400);

        await clickQuayLai();
    }

    async function processKetLuanCase() {

        showStatusBar(
            'Đang chờ tải tab Kết luận...'
        );

        const readyKetLuan =
            await waitForPageReadyOrReload(
                40000,
                'tab Kết luận'
            );

        if (!readyKetLuan) {

            return;
        }

        // Chờ thêm tới khi bảng "3. Đề nghị" (dx-list) thực sự
        // render xong trong DOM - widget này thường tải chậm
        // hơn phần còn lại, đặc biệt khi mạng lag.
        await waitForElement(
            () => findDeNghiListItem('Khác'),
            25000
        );

        await sleep(500);

        updateStatusBar(
            'Đang đọc thông tin ca khám...'
        );

        const tinhTrang =
            getTinhTrangSucKhoe();

        const benhTat =
            getBenhTat();

        const tinhTrangNorm =
            norm(tinhTrang);

        log(
            'Tình trạng sức khỏe:',
            tinhTrang,
            '| Bệnh tật:',
            benhTat
        );

        // -----------------------------------------------------
        // TRƯỜNG HỢP MỚI: Phân loại sức khỏe TRỐNG (chưa đọc
        // được giá trị nào cả) -> chọn "Khác" rồi lưu luôn,
        // không cần điền chữ gì thêm vào ô ghi rõ.
        // -----------------------------------------------------

        if (!tinhTrangNorm) {

            log(
                'Phân loại sức khỏe trống -> chọn "Khác" và lưu.'
            );

            updateStatusBar(
                'Phân loại trống - đang chọn "Khác"...'
            );

            const blankSelectionOk =
                await checkCheckboxByLabel('Khác');

            if (!blankSelectionOk) {

                hideStatusBar();

                setBatchActive(false);

                await infoModal(
                    '❌ Dừng lại - chưa chọn được',
                    '<div>Script không tự tích được checkbox ' +
                    '"Khác" cho ca có Phân loại sức khỏe trống.</div>' +
                    '<div class="klm2-note">KHÔNG tự lưu để tránh ' +
                    'lưu sai. Vui lòng xử lý tay ca này.</div>',
                    'warn'
                );

                return;
            }

            const savedOkBlank =
                await clickLuu();

            if (!savedOkBlank) {

                hideStatusBar();

                setBatchActive(false);

                await infoModal(
                    '❌ Lỗi lưu',
                    '<div>Không bấm được nút "Lưu thay đổi" ' +
                    '(ca có Phân loại sức khỏe trống). Kiểm tra thủ công.</div>'
                );

                return;
            }

            incBatchCount();

            showToast(
                `✓ Đã xử lý ca #${getBatchCount()} (Phân loại trống), đang qua ca tiếp theo...`
            );

            await sleep(300);

            await clickQuayLai();

            return;
        }

        // Không còn phân biệt Loại I/II/III/IV/V nữa - TẤT CẢ
        // các mức đều xử lý GIỐNG NHAU, chỉ dựa vào "Bệnh, tật"
        // (mã ICD) để quyết định. Chỉ coi là "khó" khi mã ICD
        // không nằm trong danh mục nhận diện được, hoặc thuộc
        // nhóm nguy hiểm (xử lý ở bước classifyBenhTat bên dưới)
        if (
            ![
                'loại i', 'loại ii', 'loại iii',
                'loại iv', 'loại v'
            ].includes(tinhTrangNorm)
        ) {

            hideStatusBar();

            await skipCurrentCase(
                `Không đọc được Tình trạng sức khỏe ("${tinhTrang}")`
            );

            return;
        }

        updateStatusBar(
            'Đang xác định Đề nghị phù hợp...'
        );

        const classification =
            classifyBenhTat(benhTat);

        let selectionOk = true;

        if (classification.type === 'normal') {

            updateStatusBar(
                'Đang chọn "Bình thường..."'
            );

            selectionOk =
                await checkCheckboxByLabel(
                    'Bình thường, hẹn khám định kỳ lần sau'
                );

        } else if (classification.type === 'specialty') {

            updateStatusBar(
                'Đang chọn "Khác" và điền chuyên khoa...'
            );

            selectionOk =
                await checkCheckboxByLabel('Khác');

            if (selectionOk) {

                const filledOk =
                    await fillDeNghiGhiRo(
                        classification.text
                    );

                selectionOk =
                    selectionOk && filledOk;
            }

        } else {

            hideStatusBar();

            await skipCurrentCase(
                classification.reason
            );

            return;
        }

        // -----------------------------------------------------
        // CHỈ Lưu nếu chọn/điền THÀNH CÔNG thật sự (đã kiểm
        // tra lại, không phải chỉ "đã bấm"). Trước đây có lỗi
        // vẫn lưu dù chưa chọn được gì - rất nguy hiểm.
        // -----------------------------------------------------

        if (!selectionOk) {

            hideStatusBar();

            setBatchActive(false);

            await infoModal(
                '❌ Dừng lại - chưa chọn/điền được',
                '<div>Script không tự tích được checkbox hoặc ' +
                'điền được ô "Đề nghị (ghi rõ)" cho ca này.</div>' +
                '<div class="klm2-note">KHÔNG tự lưu để tránh ' +
                'lưu sai. Vui lòng kiểm tra/xử lý tay ca này, ' +
                'rồi báo lại để mình sửa script.</div>',
                'warn'
            );

            return;
        }

        const savedOk =
            await clickLuu();

        if (!savedOk) {

            hideStatusBar();

            setBatchActive(false);

            await infoModal(
                '❌ Lỗi lưu',
                '<div>Không bấm được nút "Lưu thay đổi". Kiểm tra thủ công.</div>'
            );

            return;
        }

        incBatchCount();

        showToast(
            `✓ Đã xử lý ca #${getBatchCount()}, đang qua ca tiếp theo...`
        );

        await sleep(300);

        await clickQuayLai();
    }


    // =========================================================
    // NÚT ĐIỀU KHIỂN: BẮT ĐẦU / DỪNG
    // =========================================================

    function createControlButtons() {

        if (
            document.getElementById('klm2-start-btn')
        ) {

            return;
        }

        const startBtn =
            document.createElement('button');

        startBtn.id = 'klm2-start-btn';

        startBtn.className = 'klm2-toolbar-btn';

        startBtn.innerText =
            isBatchActive()
                ? '⏳ Đang chạy KL M2...'
                : '🚀 AUTO KL M2';

        Object.assign(
            startBtn.style,
            {
                position: 'fixed',
                right: '20px',
                bottom: '420px',
                zIndex: '999999',
                padding: '8px 14px',
                background: '#d97706',
                color: '#fff',
                border: 'none',
                borderRadius: '999px',
                fontSize: '13px',
                fontWeight: 'bold',
                cursor: 'pointer',
                boxShadow: '0 3px 10px rgba(0,0,0,.3)'
            }
        );

        const stopBtn =
            document.createElement('button');

        stopBtn.id = 'klm2-stop-btn';

        stopBtn.className = 'klm2-toolbar-btn';

        stopBtn.innerText = '⏹ DỪNG KL M2';

        Object.assign(
            stopBtn.style,
            {
                position: 'fixed',
                right: '20px',
                bottom: '465px',
                zIndex: '999999',
                padding: '8px 14px',
                background: '#dc2626',
                color: '#fff',
                border: 'none',
                borderRadius: '999px',
                fontSize: '13px',
                fontWeight: 'bold',
                cursor: 'pointer',
                boxShadow: '0 3px 10px rgba(0,0,0,.3)',
                display: isBatchActive() ? 'block' : 'none'
            }
        );

        startBtn.addEventListener(
            'click',
            async () => {

                const confirmed =
                    await confirmModal(
                        '🚀 Bắt đầu Auto KL M2',
                        '<div>Script sẽ tự động chạy qua từng ca trong ' +
                        'danh sách "chưa kết luận" - chỉ tự xử lý ca ' +
                        '<b>Loại I/II không bệnh</b> hoặc <b>có bệnh ' +
                        'rõ chuyên khoa</b>. Gặp ca khó (Loại III/IV/V, ' +
                        'bệnh nguy hiểm, mã lạ) sẽ tự DỪNG và báo bạn.</div>' +
                        '<div class="klm2-note">⚠️ Script sẽ tự LƯU thật ' +
                        '(bấm "Lưu thay đổi" tự động) - hãy theo dõi kỹ ' +
                        'trong vài ca đầu để chắc chắn hoạt động đúng.</div>'
                    );

                if (!confirmed) {

                    return;
                }

                resetBatchCount();

                resetSkipIndex();

                resetReloadCount();

                resetSkippedList();

                setBatchActive(true);

                stopBtn.style.display = 'block';

                startBtn.innerText =
                    '⏳ Đang chạy KL M2...';

                // Dùng chung logic nhận diện trang với
                // continueBatchFlow() - cho phép bắt đầu từ
                // BẤT KỲ trang nào (Danh sách, Kết luận đang
                // xem sẵn, hoặc trang chi tiết trung gian)
                await runBatchStepSafely();
            }
        );

        stopBtn.addEventListener(
            'click',
            () => {

                setBatchActive(false);

                stopBtn.style.display = 'none';

                startBtn.innerText =
                    '🚀 AUTO KL M2';

                showToast(
                    '⏹ Đã dừng Auto KL M2.'
                );
            }
        );

        document.body.appendChild(startBtn);

        document.body.appendChild(stopBtn);
    }


    // =========================================================
    // KHỞI ĐỘNG: nếu batch đang chạy, tự tiếp tục theo đúng
    // bước (Danh sách -> Chi tiết -> Kết luận -> xử lý -> Lưu
    // -> Quay lại -> Danh sách...)
    // =========================================================

    async function continueBatchFlow() {

        if (!isBatchActive()) {

            log(
                'Batch không active, chờ người dùng bấm nút.'
            );

            return;
        }

        log(
            'Batch đang active, tự tiếp tục...'
        );

        showStatusBar(
            'Đang xác định trang hiện tại...'
        );

        const readyContinue =
            await waitForPageReadyOrReload(
                40000,
                'xác định trang hiện tại'
            );

        if (!readyContinue) {

            return;
        }

        if (isKetLuanPage()) {

            await processKetLuanCase();

        } else if (isDanhSachPage()) {

            await goToFirstCase();

        } else {

            // Trang chi tiết khác (Thông tin hành chính...)
            // -> tìm và bấm "Kết luận" ở sidebar
            await goToKetLuanTab();
        }
    }


    // =========================================================
    // THEO DÕI ĐIỀU HƯỚNG SPA (Angular đổi trang KHÔNG tải lại
    // trang thật) - vì phát hiện thực tế: bấm bút chì trong
    // Danh sách chỉ đổi URL nội bộ (pushState), KHÔNG có sự
    // kiện tải trang thật để userscript tự chạy lại. Nên phải
    // tự bắt sự kiện đổi URL (pushState/replaceState/popstate)
    // rồi CHỦ ĐỘNG chạy lại logic batch mỗi khi phát hiện đổi
    // trang, thay vì chỉ trông chờ vào document-idle 1 lần.
    // =========================================================

    let isBatchBusy =
        false;

    async function runBatchStepSafely() {

        if (isBatchBusy) {

            log(
                'Đang bận xử lý bước trước, bỏ qua lần gọi này.'
            );

            return;
        }

        isBatchBusy = true;

        try {

            await continueBatchFlow();

        } catch (e) {

            console.error(LOG, e);

            hideStatusBar();

            setBatchActive(false);

            await infoModal(
                '❌ Lỗi script - đã dừng batch',
                `<div>${(e && e.message) || String(e)}</div>` +
                '<div class="klm2-note">Mở Console (F12) xem chi tiết lỗi. ' +
                'Gửi lại nội dung lỗi này để mình sửa.</div>',
                'warn'
            );

        } finally {

            isBatchBusy = false;
        }
    }

    async function onRouteChange() {

        if (isBatchBusy) {

            return;
        }

        if (!isBatchActive()) {

            return;
        }

        log(
            'Phát hiện đổi trang (URL:',
            location.href,
            ') - tự tiếp tục batch...'
        );

        // Đợi Angular bắt đầu render nội dung route mới trước
        // khi kiểm tra, tránh đọc nhầm nội dung cũ
        await sleep(400);

        await runBatchStepSafely();
    }

    function installSpaNavigationWatcher() {

        if (
            window.__klm2NavWatcherInstalled
        ) {

            return;
        }

        window.__klm2NavWatcherInstalled = true;

        const originalPushState =
            history.pushState;

        const originalReplaceState =
            history.replaceState;

        history.pushState = function (...args) {

            const result =
                originalPushState.apply(
                    this,
                    args
                );

            window.dispatchEvent(
                new Event('klm2-locationchange')
            );

            return result;
        };

        history.replaceState = function (...args) {

            const result =
                originalReplaceState.apply(
                    this,
                    args
                );

            window.dispatchEvent(
                new Event('klm2-locationchange')
            );

            return result;
        };

        window.addEventListener(
            'popstate',
            () => {

                window.dispatchEvent(
                    new Event('klm2-locationchange')
                );
            }
        );

        window.addEventListener(
            'klm2-locationchange',
            onRouteChange
        );

        // -------------------------------------------------
        // DỰ PHÒNG CHẮC ĂN: polling kiểm tra URL định kỳ,
        // KHÔNG phụ thuộc vào việc hook pushState/replaceState
        // có bắt được hay không - vì Angular (zone.js) có thể
        // đã tự bọc history API từ trước khi script này chạy,
        // khiến hook ở trên bị "qua mặt" (gọi thẳng bản gốc,
        // không qua bản đã ghi đè của mình). Polling luôn bắt
        // được thay đổi URL bất kể cơ chế nào gây ra.
        // -------------------------------------------------

        let lastKnownUrl =
            location.href;

        setInterval(
            () => {

                // QUAN TRỌNG: chỉ đánh dấu "đã thấy URL này"
                // khi KHÔNG bận (isBatchBusy = false). Nếu
                // đang bận mà vẫn đánh dấu, tín hiệu đổi URL
                // đó sẽ MẤT VĨNH VIỄN (vì lần sau URL không
                // còn khác lastKnownUrl nữa) - đây chính là
                // bug gây treo ở bản trước.
                if (
                    location.href !== lastKnownUrl &&
                    !isBatchBusy
                ) {

                    lastKnownUrl =
                        location.href;

                    log(
                        'Polling phát hiện đổi URL:',
                        lastKnownUrl
                    );

                    onRouteChange();
                }
            },
            500
        );

        log(
            'Đã cài đặt theo dõi điều hướng SPA.'
        );
    }


    async function init() {

        createControlButtons();

        installSpaNavigationWatcher();

        await runBatchStepSafely();
    }

    init();

})();
