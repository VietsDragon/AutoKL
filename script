    }

    function showStatusBar(message) {

        ensureModalStyles();

        let bar =
            document.getElementById(
                'klm2-status-bar'
            );

        if (!bar) {

            bar =
                document.createElement('div');

            bar.id = 'klm2-status-bar';

            document.body.appendChild(bar);
        }

        bar.innerHTML =
            '<span class="klm2-spin"></span>' +
            '<span>' + message + '</span>';

        bar.style.display = 'flex';
    }

    function hideStatusBar() {

        const bar =
            document.getElementById(
                'klm2-status-bar'
            );

        if (bar) {

            bar.style.display = 'none';
        }
    }

    function updateStatusBar(message) {

        showStatusBar(message);
    }

    function showModal(
        { title, titleClass, bodyHtml, buttons }
    ) {

        ensureModalStyles();

        return new Promise(
            resolve => {

                const overlay =
                    document.createElement(
                        'div'
                    );

                overlay.className =
                    'klm2-overlay';

                const box =
                    document.createElement(
                        'div'
                    );

                box.className =
                    'klm2-box';

                const header =
                    document.createElement(
                        'div'
                    );

                header.className =
                    'klm2-header' +
                    (
                        titleClass
                            ? (' ' + titleClass)
                            : ''
                    );

                header.textContent =
                    title;

                const body =
                    document.createElement(
                        'div'
                    );

                body.className =
                    'klm2-body';

                body.innerHTML =
                    bodyHtml;

                const footer =
                    document.createElement(
                        'div'
                    );

                footer.className =
                    'klm2-footer';

                buttons.forEach(
                    btn => {

                        const b =
                            document.createElement(
                                'button'
                            );

                        b.className =
                            'klm2-btn ' +
                            (
                                btn.primary
                                    ? 'klm2-btn-primary'
                                    : 'klm2-btn-secondary'
                            );

                        b.textContent =
                            btn.label;

                        b.addEventListener(
                            'click',
                            () => {

                                document.body.removeChild(
                                    overlay
                                );

                                resolve(
                                    btn.value
                                );
                            }
                        );

                        footer.appendChild(
                            b
                        );
                    }
                );

                box.appendChild(header);
                box.appendChild(body);
                box.appendChild(footer);
                overlay.appendChild(box);
                document.body.appendChild(overlay);
            }
        );
    }

    function infoModal(
        title,
        bodyHtml,
        titleClass
    ) {

        return showModal({
            title,
            titleClass,
            bodyHtml,
            buttons: [
                { label: 'Đóng', value: true, primary: true }
            ]
        });
    }

    function confirmModal(
        title,
        bodyHtml,
        titleClass
    ) {

        return showModal({
            title,
            titleClass,
            bodyHtml,
            buttons: [
                { label: 'Huỷ', value: false },
                { label: 'Xác nhận', value: true, primary: true }
            ]
        });
    }

    function showToast(
        message,
        durationMs
    ) {

        ensureModalStyles();

        const toast =
            document.createElement(
                'div'
            );

        toast.className =
            'klm2-toast';

        toast.textContent =
            message;

        document.body.appendChild(
            toast
        );

        requestAnimationFrame(
            () => {

                toast.classList.add(
                    'show'
                );
            }
        );

        setTimeout(
            () => {

                toast.classList.remove(
                    'show'
                );

                setTimeout(
                    () => {

                        if (toast.parentNode) {

                            toast.parentNode.removeChild(
                                toast
                            );
                        }
                    },
                    300
                );
            },
            durationMs || 3000
        );
    }


    // =========================================================
    // TRẠNG THÁI CHẠY HÀNG LOẠT (localStorage - sống sót qua
    // các lần tải trang, vì luồng này điều hướng Danh sách <->
    // Chi tiết liên tục, mỗi lần là 1 lần script chạy lại từ
    // đầu)
    // =========================================================

    function isBatchActive() {

        return (
            localStorage.getItem(
                STORAGE_ACTIVE_KEY
            ) === '1'
        );
    }

    function setBatchActive(active) {

        if (active) {

            localStorage.setItem(
                STORAGE_ACTIVE_KEY,
                '1'
            );

        } else {

            localStorage.removeItem(
                STORAGE_ACTIVE_KEY
            );
        }
    }

    function getBatchCount() {

        return parseInt(
            localStorage.getItem(
                STORAGE_COUNT_KEY
            ) || '0',
            10
        );
    }

    function incBatchCount() {

        localStorage.setItem(
            STORAGE_COUNT_KEY,
            String(
                getBatchCount() + 1
            )
        );
    }

    function resetBatchCount() {

        localStorage.removeItem(
            STORAGE_COUNT_KEY
        );
    }


    // -----------------------------------------------------------
    // "VỊ TRÍ BỎ QUA" - đếm số ca liên tiếp ở ĐẦU danh sách đã
    // bị bỏ qua (quá khó, chưa xử lý được) trong phiên chạy
    // này. Ca bỏ qua KHÔNG lưu gì nên vẫn còn nguyên trong danh
    // sách "chưa kết luận" - lần tải lại danh sách vẫn thấy nó
    // ở đầu, nên cần biết để bấm đúng dòng tiếp theo (bỏ qua
    // đúng số dòng đã biết là khó), thay vì luôn bấm dòng đầu.
    // -----------------------------------------------------------

    function getSkipIndex() {

        return parseInt(
            localStorage.getItem(
                STORAGE_SKIP_INDEX_KEY
            ) || '0',
            10
        );
    }

    function incSkipIndex() {

        localStorage.setItem(
            STORAGE_SKIP_INDEX_KEY,
            String(
                getSkipIndex() + 1
            )
        );
    }

    function resetSkipIndex() {

        localStorage.removeItem(
            STORAGE_SKIP_INDEX_KEY
        );
    }

    function getSkippedList() {

        try {

            return JSON.parse(
                localStorage.getItem(
                    STORAGE_SKIPPED_LIST_KEY
                ) || '[]'
            );

        } catch (e) {

            return [];
        }
    }

    function addToSkippedList(entry) {

        const list =
            getSkippedList();

        list.push(entry);

        localStorage.setItem(
            STORAGE_SKIPPED_LIST_KEY,
            JSON.stringify(list)
        );
    }

    function resetSkippedList() {

        localStorage.removeItem(
            STORAGE_SKIPPED_LIST_KEY
        );
    }


    // =========================================================
    // CHỜ PHẦN TỬ XUẤT HIỆN (chủ động, không sleep cố định)
    // =========================================================

    async function waitForElement(
        selectorFn,
        timeoutMs
    ) {

        const start =
            Date.now();

        while (
            Date.now() - start < (timeoutMs || 5000)
        ) {

            const el =
                selectorFn();

            if (el) {

                return el;
            }

            await sleep(100);
        }

        return null;
    }


    // =========================================================
    // CHỜ TRANG THỰC SỰ TẢI XONG (chủ động, không đoán thời
    // gian cố định) - mạng lag nên cần kiểm tra kỹ trước khi
    // thao tác, tránh bấm hụt/đọc nhầm dữ liệu cũ còn sót lại
    // từ trang trước.
    //
    // Kiểm tra: document.readyState = 'complete' VÀ nội dung
    // trang đã có chữ (không còn trống/màn hình trắng) VÀ giữ
    // ổn định (không còn thay đổi độ dài) trong 1 khoảng ngắn
    // liên tiếp - dấu hiệu Angular đã render xong, không phải
    // đang render dở.
    // =========================================================

    async function waitForPageReady(timeoutMs) {

        const start =
            Date.now();

        // SỬA LỖI: trước đây luôn bị giới hạn cứng ở 8 giây
        // (Math.min với 8000) bất kể truyền vào bao nhiêu -
        // đây là nguyên nhân chính khiến batch dừng sớm khi
        // mạng lag. Giờ dùng ĐÚNG giá trị truyền vào.
        const maxWait =
            timeoutMs || 30000;

        while (
            Date.now() - start < maxWait
        ) {

            const bodyLength =
                (document.body.innerText || '').length;

            const domReady =
                document.readyState === 'complete';

            if (
                domReady &&
                bodyLength > 50
            ) {

                // Không đòi hỏi ổn định tuyệt đối nữa (dễ bị
                // treo nếu trang có phần tử liên tục đổi nhẹ,
                // VD đồng hồ/đếm giờ) - chỉ cần đã có nội dung
                // + readyState xong, rồi đợi thêm 1 khoảng cố
                // định ngắn cho Angular hoàn tất render.
                await sleep(700);

                return true;
            }

            await sleep(150);
        }

        warn(
            'waitForPageReady: hết thời gian chờ, trang có ' +
            'thể chưa tải xong hoàn toàn - vẫn tiếp tục.'
        );

        return false;
    }


    // -----------------------------------------------------------
    // NẾU CHỜ QUÁ LÂU MÀ TRANG VẪN CHƯA TẢI XONG -> TỰ F5 LẠI
    // (tối đa 3 lần liên tiếp, tránh vòng lặp F5 vô tận nếu
    // trang thực sự bị lỗi/mất mạng hẳn). Trạng thái batch vẫn
    // được giữ nguyên qua localStorage nên F5 xong script tự
    // tiếp tục đúng chỗ.
    // -----------------------------------------------------------

    const STORAGE_RELOAD_COUNT_KEY =
        'medinet_kl_m2_reload_count';

    function getReloadCount() {

        return parseInt(
            localStorage.getItem(
                STORAGE_RELOAD_COUNT_KEY
            ) || '0',
            10
        );
    }

    function incReloadCount() {

        localStorage.setItem(
            STORAGE_RELOAD_COUNT_KEY,
            String(
                getReloadCount() + 1
            )
        );
    }

    function resetReloadCount() {

        localStorage.removeItem(
            STORAGE_RELOAD_COUNT_KEY
        );
    }

    async function waitForPageReadyOrReload(
        timeoutMs,
        context
    ) {

        const ready =
            await waitForPageReady(timeoutMs);

        if (ready) {

            resetReloadCount();

            return true;
        }

        const reloadCount =
            getReloadCount();

        if (reloadCount >= 3) {

            hideStatusBar();

            setBatchActive(false);

            resetReloadCount();

            await infoModal(
                '❌ Tải trang thất bại nhiều lần',
                `<div>Đã thử F5 lại 3 lần nhưng trang vẫn ` +
                `không tải xong${context ? ` (${context})` : ''}.</div>` +
                '<div class="klm2-note">Vui lòng kiểm tra kết ' +
                'nối mạng, rồi bấm lại "🚀 AUTO KL M2".</div>'
            );

            return false;
        }

        incReloadCount();

        log(
            `Trang tải quá lâu${context ? ` (${context})` : ''} ` +
            `- tự F5 lại (lần ${reloadCount + 1}/3)...`
        );

        showStatusBar(
            `Trang tải quá lâu - đang F5 lại (lần ${reloadCount + 1}/3)...`
        );

        await sleep(500);

        location.reload();

        // Trang sắp tải lại - không cần làm gì thêm, để hàm
        // gọi không tiếp tục chạy tiếp với trang cũ dở dang
        await new Promise(() => {});
    }


    // =========================================================
    // NHẬN DIỆN TRANG HIỆN TẠI
    // =========================================================

    function isDanhSachPage() {

        return (
            location.href.includes(
                'viewer-utility/KSKDK_DanhSach'
            ) ||
            norm(
                document.body.innerText
            ).includes(
                'chất lượng dữ liệu'
            )
        );
    }

    function isKetLuanPage() {

        return (
            location.href.includes(
                'KSKD18_KetLuanKham'
            ) ||
            norm(
                document.body.innerText
            ).includes(
                'kết luận khám bệnh nhân dưới 18 tuổi'
            )
        );
    }


    // =========================================================
    // TRANG DANH SÁCH: bấm bút chì dòng đầu tiên
    // =========================================================

    function findAllPencilLinks() {

        const links = [
            ...document.querySelectorAll(
                'a[href="javascript:;"]'
            )
        ];

        return links.filter(
            a =>
                a.querySelector('i.fa-pen')
        );
    }

    function findPencilLinkAtSkipIndex() {

        const links =
            findAllPencilLinks();

        const idx =
            getSkipIndex();

        return links[idx] || null;
    }

    async function goToFirstCase() {

        showStatusBar(
            'Đang chờ tải Danh sách...'
        );

        const readyList =
            await waitForPageReadyOrReload(
                40000,
                'trang Danh sách'
            );

        if (!readyList) {

            return;
        }

        updateStatusBar(
            'Đang tìm ca tiếp theo...'
        );

        const link =
            await waitForElement(
                findPencilLinkAtSkipIndex,
                30000
            );

        if (!link) {

            hideStatusBar();

            setBatchActive(false);

            const skipped =
                getSkippedList();

            const skippedHtml =
                skipped.length
                    ? (
                        '<div style="margin-top:10px;">' +
                        `<b>${skipped.length} ca đã bỏ qua (cần xử lý tay):</b>` +
                        '<ul style="margin:6px 0 0;padding-left:20px;">' +
                        skipped.map(
                            s =>
                                `<li>${s.name} - ${s.reason}</li>`
                        ).join('') +
                        '</ul></div>'
                    )
                    : '';

            await infoModal(
                '✅ Hết ca dễ trong danh sách',
                '<div>Không còn ca nào chưa xử lý ở vị trí ' +
                'tiếp theo (có thể đã xử lý/bỏ qua hết các ca, ' +
                'hoặc trang tải quá chậm).</div>' +
                `<div class="klm2-note">Đã xử lý tự động: ${getBatchCount()} ca trong lần chạy này.</div>` +
                skippedHtml
            );

            return;
        }

        log(
            'Vào ca tiếp theo...'
        );

        updateStatusBar(
            'Đang mở ca tiếp theo...'
        );

        const startUrl =
            location.href;

        robustClick(link);

        await sleep(600);

        if (
            location.href === startUrl &&
            !isKetLuanPage()
        ) {

            // Thử lại 1 lần với fastClick (dự phòng, phòng
            // khi robustClick lại không hợp với thẻ <a> này)
            fastClick(link);

            await sleep(600);
        }
    }


    // =========================================================
    // TÌM VÀ BẤM "KẾT LUẬN" Ở SIDEBAR
    //
    // ⚠️ CHƯA CÓ HTML THẬT CỦA SIDEBAR - đoán theo cấu trúc
    // phổ biến của các trang khác (leaf element khớp đúng chữ
    // "Kết luận"). Nếu không bấm đúng, cần gửi HTML sidebar
    // thật để chỉnh lại.
    // =========================================================

    function findKetLuanSidebarItem() {

        // Xác nhận thật: DevExtreme TreeView, mỗi mục sidebar
