    function findButtonByText(text) {

        const target =
            norm(text);

        // DevExtreme dxButton thường render là <div
        // role="button"> hoặc <div class="dx-button">, KHÔNG
        // phải thẻ <button> thật - phải tìm rộng hơn.
        const buttons = [
            ...document.querySelectorAll(
                'button, a, div[role="button"], ' +
                'span[role="button"], .dx-button'
            )
