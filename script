    // =========================================================
    // BẢNG NHÓM MÃ ICD -> CHUYÊN KHOA (tra + suy đoán theo
    // chương ICD-10 chuẩn - CHỈ mang tính tham khảo, cần rà
    // soát lại theo thực tế)
    // =========================================================

    const ICD_SPECIALTY_MAP = [
        { test: c => /^K(0[0-9]|1[0-4])/.test(c), text: 'Khám Răng' },
        { test: c => /^H([0-4][0-9]|5[0-9])/.test(c), text: 'Khám Mắt' },
        { test: c => /^H([6-9][0-9])/.test(c), text: 'Khám Tai Mũi Họng' },
        { test: c => /^J[0-9]{2}/.test(c), text: 'Khám Hô hấp' },
        { test: c => /^I[0-9]{2}/.test(c), text: 'Khám Tim mạch' },
        { test: c => /^K(2[0-9]|[3-9][0-9])/.test(c), text: 'Khám Tiêu hóa' },
        { test: c => /^L[0-9]{2}/.test(c), text: 'Khám Da liễu' },
        { test: c => /^M[0-9]{2}/.test(c), text: 'Khám Cơ Xương Khớp' },
        { test: c => /^N([0-3][0-9])/.test(c), text: 'Khám Thận - Tiết niệu' },
        { test: c => /^N([4-9][0-9])/.test(c), text: 'Khám chuyên khoa' },
        { test: c => /^E[0-9]{2}/.test(c), text: 'Khám Nội tiết' },
        { test: c => /^F[0-9]{2}/.test(c), text: 'Khám Tâm thần' },
        { test: c => /^G[0-9]{2}/.test(c), text: 'Khám Thần kinh' },
        { test: c => /^D([5-8][0-9])/.test(c), text: 'Khám Huyết học' }
    ];

    // Nhóm NGUY HIỂM/CẦN BÁC SĨ QUYẾT ĐỊNH - không tự đoán
    const ICD_STOP_GROUPS = [
        {
            test: c => /^C[0-9]{2}/.test(c) || /^D([0-4][0-9])/.test(c),
            reason: 'nhóm u bướu (C00-D48)'
        },
        {
            test: c => /^[ST][0-9]{2}/.test(c),
            reason: 'nhóm chấn thương (S00-T98)'
        }
    ];

    function extractIcdCodes(text) {

        const matches = [
            ...(text || '').matchAll(
                /\(([A-Z]\d{2}(?:\.\d+)?)\)/g
            )
        ];

        return matches.map(
            m => m[1]
        );
    }

    function classifyBenhTat(benhTatText) {

        const trimmed =
            (benhTatText || '').trim();

        if (
            !trimmed ||
            norm(trimmed) === 'không có'
        ) {

            return { type: 'normal' };
        }

        const codes =
            extractIcdCodes(trimmed);

        if (!codes.length) {

            return {
                type: 'unknown',
                reason: `Không nhận diện được mã ICD trong nội dung: "${trimmed}"`
            };
        }

        for (const code of codes) {

            const stopMatch =
                ICD_STOP_GROUPS.find(
                    g => g.test(code)
                );

            if (stopMatch) {

                return {
                    type: 'stop',
                    reason: `Mã ${code} thuộc ${stopMatch.reason} - cần bác sĩ quyết định`
                };
            }
        }

        const specialties =
            new Set();

        const unmatched =
            [];

        for (const code of codes) {

            const match =
                ICD_SPECIALTY_MAP.find(
                    g => g.test(code)
                );

            if (match) {

                specialties.add(
                    match.text
                );

            } else {

                unmatched.push(code);
            }
        }

        if (unmatched.length) {

            return {
                type: 'unknown',
                reason: `Không nhận diện được nhóm cho mã: ${unmatched.join(', ')}`
            };
        }

        return {
            type: 'specialty',
            text: [...specialties].join(', ')
        };
    }


    // =========================================================
    // CHỌN LỰA CHỌN TRONG "3. ĐỀ NGHỊ" (dx-list dạng chọn 1,
    // style giống ô vuông nhưng thực chất là role="radio" bên
    // trong mỗi .dx-list-item - ĐÃ XÁC NHẬN qua HTML thật, y
    // hệt kiểu 22 câu Tiền sử / D-code trong Auto M3/M4)
    // =========================================================

    function findLabelsByExactText(targetText) {

        const target =
            norm(targetText);

        return [
            ...document.querySelectorAll('b')
        ].filter(
            b =>
                norm(b.textContent)
                    .replace(/\*\s*$/, '')
                    .trim() === target
        );
    }

    function findDeNghiListItem(labelText) {

        const target =
            norm(labelText);

        const items = [
            ...document.querySelectorAll(
                '.dx-item.dx-list-item[role="option"]'
            )
        ];

        return (
            items.find(
                item => {

                    const content =
                        item.querySelector(
                            '.dx-item-content.dx-list-item-content'
                        ) ||
                        item.querySelector(
                            '.dx-item-content'
                        );

                    return (
                        content &&
                        norm(content.textContent) === target
                    );
                }
            ) || null
        );
    }

    function isDeNghiItemSelected(item) {

        if (!item) {

            return false;
        }

        if (
            item.getAttribute('aria-selected') === 'true'
        ) {

            return true;
        }

        if (
            item.classList.contains('dx-list-item-selected')
        ) {

            return true;
        }

        const radio =
            item.querySelector('[role="radio"]');

        return (
            !!radio &&
            radio.getAttribute('aria-checked') === 'true'
        );
    }

    async function checkCheckboxByLabel(labelText) {

        // Chờ CHỦ ĐỘNG tới khi thấy đúng lựa chọn xuất hiện
        // (tối đa 10s) - vì bảng "3. Đề nghị" là dx-list, có
        // thể render trễ hơn phần còn lại của trang, đặc biệt
        // khi mạng lag.
        const item =
            await waitForElement(
                () => findDeNghiListItem(labelText),
                25000
            );

        if (!item) {

            warn(
                'Không tìm thấy lựa chọn "Đề nghị":',
                labelText
            );

            return false;
        }

        if (
            isDeNghiItemSelected(item)
        ) {

            return true;
        }

        // Thử NHIỀU điểm click khác nhau qua từng lần (không
        // lặp lại đúng 1 điểm) - vì DevExtreme dx-list có thể
        // cần click trúng đúng phần radio icon bên trong, không
        // phải click vào đâu trên hàng cũng nhận.
        const radio =
            item.querySelector('[role="radio"]') ||
            item.querySelector('.dx-list-select-radiobutton');

        const contentEl =
            item.querySelector('.dx-item-content');

        const clickTargets = [
            item,
            radio,
            contentEl
        ].filter(Boolean);

        for (
            let attempt = 0;
            attempt < clickTargets.length;
            attempt++
        ) {

            robustClick(
                clickTargets[attempt]
            );

            await sleep(400);

            if (
                isDeNghiItemSelected(item)
            ) {

                return true;
            }

            warn(
                `Lựa chọn "${labelText}" chưa chọn được sau ` +
                `lần bấm ${attempt + 1}/${clickTargets.length} ` +
                '(khác điểm click), thử lại...'
            );
        }

        warn(
            `⚠️ KHÔNG chọn được "${labelText}" sau ${clickTargets.length} lần thử.`
        );

        return false;
    }


    // =========================================================
    // ĐIỀN Ô "ĐỀ NGHỊ (GHI RÕ)"
    //
    // ⚠️ CHƯA CÓ HTML THẬT của ô này - đoán là textarea hoặc
    // ô DevExtreme text thường. Có cơ chế dự phòng (lấy
    // textarea đầu tiên trên trang) nếu không tìm theo nhãn.
    // =========================================================

    const nativeInputValueSetter =
        Object.getOwnPropertyDescriptor(
            window.HTMLInputElement.prototype,
            'value'
        ).set;

    const nativeTextareaValueSetter =
        Object.getOwnPropertyDescriptor(
            window.HTMLTextAreaElement.prototype,
            'value'
        ).set;

    async function dispatchElementValue(el, displayVal) {

        el.focus();

        const isContentEditable =
            el.isContentEditable ||
            el.getAttribute('contenteditable') === 'true';

        if (isContentEditable) {

            el.textContent = displayVal;

        } else if (el.tagName === 'TEXTAREA') {

            nativeTextareaValueSetter.call(
                el,
                displayVal
            );

        } else {

            nativeInputValueSetter.call(
                el,
                displayVal
            );
        }

        el.dispatchEvent(
            new Event('input', { bubbles: true })
        );

        el.dispatchEvent(
            new KeyboardEvent('keyup', { bubbles: true })
        );

        el.dispatchEvent(
            new Event('change', { bubbles: true })
        );

        el.blur();

        el.dispatchEvent(
            new Event('blur', { bubbles: true })
        );

        el.dispatchEvent(
            new FocusEvent('focusout', { bubbles: true })
        );
    }

    function findDeNghiGhiRoInput() {

        const labels =
            findLabelsByExactText('Đề nghị ( ghi rõ)')
                .concat(
                    findLabelsByExactText('Đề nghị (ghi rõ)')
                );

        const selector =
            'textarea, input.dx-texteditor-input, ' +
            '[contenteditable="true"]';

        for (const label of labels) {

            let current = label;

            for (let level = 0; level < 12; level++) {

                if (!current) {
                    break;
                }

                const input =
                    current.querySelector(selector);

                if (input) {

                    return input;
                }

                current =
                    current.parentElement;
            }
        }

        // Dự phòng: nhãn tìm được nhưng leo cha không ra ô
        // nhập - tìm phần tử input/textarea/contenteditable
        // ĐẦU TIÊN xuất hiện SAU nhãn theo thứ tự DOM (không
        // phụ thuộc quan hệ cha-con)
        if (labels.length) {

            const label = labels[0];

            const allCandidates = [
                ...document.querySelectorAll(selector)
            ];

            const afterLabel =
                allCandidates.find(
                    el => {

                        const pos =
                            label.compareDocumentPosition(el);

                        return (
                            !!(
                                pos &
                                Node.DOCUMENT_POSITION_FOLLOWING
                            )
                        );
                    }
                );

            if (afterLabel) {

                return afterLabel;
            }
        }

        // Dự phòng cuối: textarea đầu tiên trên trang
        const textareas = [
            ...document.querySelectorAll('textarea')
        ];

        return textareas[0] || null;
    }

    async function fillDeNghiGhiRo(text) {

        // Chờ chủ động ô này xuất hiện (tối đa 8s)
        const input =
            await waitForElement(
                findDeNghiGhiRoInput,
                20000
            );

        if (!input) {

            warn(
                'Không tìm thấy ô "Đề nghị (ghi rõ)"'
            );

            return false;
        }

        await dispatchElementValue(input, text);

        await sleep(300);

        // Kiểm tra lại đã điền vào thật chưa
        const actualValue =
            (
                input.value !== undefined
                    ? input.value
                    : input.textContent
            ) || '';

        if (
            !norm(actualValue).includes(norm(text))
        ) {

            warn(
                `Điền "Đề nghị (ghi rõ)" chưa chắc thành công ` +
                `(mong đợi "${text}", hiện thấy "${actualValue}")`
            );

            return false;
        }

        return true;
    }


